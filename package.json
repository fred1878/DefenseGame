{
  "name": "defensegame",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:phaser": "node scripts/build-phaser-custom.mjs",
    "postinstall": "node scripts/install-phaser-defense.mjs",
    "build": "node scripts/install-phaser-defense.mjs && tsc -b && vite build && node scripts/assert-phaser-chunk-size.mjs && node scripts/write-version.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:e2e": "VITE_E2E=true VITE_BUILD_ID=e2e-local VITE_BASE=/ npm run build",
    "e2e:manual": "npm run build:e2e && playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ci": "CI=1 playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^2.1.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "webpack": "^5.99.9"
  }
}
