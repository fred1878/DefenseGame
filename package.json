{
  "name": "defensegame",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:phaser": "node scripts/build-phaser-custom.mjs",
    "postinstall": "node scripts/install-phaser-defense.mjs",
    "build": "tsc -b && npm run build:app",
    "build:app": "node scripts/install-phaser-defense.mjs && vite build && node scripts/assert-phaser-chunk-size.mjs && node scripts/write-version.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome lint --error-on-warnings",
    "format": "biome format --write",
    "knip": "knip",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run knip && npm run test",
    "test:coverage": "vitest run --coverage",
    "build:e2e": "VITE_E2E=true VITE_BUILD_ID=e2e-local VITE_BASE=/ npm run build",
    "e2e:manual": "npm run build:e2e && playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ci": "CI=1 playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.2",
    "knip": "6.48.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "webpack": "^5.99.9"
  }
}
